# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Backend API URL (optional, defaults to http://localhost:3001)
VITE_API_URL=http://localhost:3001

# ============================================================================
# SERVER-SIDE ONLY (Do not prefix with VITE_)
# These credentials are kept secure on the backend server
# ============================================================================

# Salesforce OAuth Credentials
# The portal writes to both GTCX and DemoCX. Prefer the named variables below
# for Render or any hosted API deployment. Legacy SALESFORCE_* and
# SALESFORCE_*_2 variables are still supported for local compatibility.
# Auth methods are tried in order. Hosted deployments should normally use sfdx
# auth URLs or refresh tokens; local development can use cli if aliases exist.
SALESFORCE_AUTH_METHODS=sfdx,refresh,password,cli

# GTCX sandbox
SALESFORCE_GTCX_SFDX_AUTH_URL=force://client_id:client_secret:refresh_token@your-instance.my.salesforce.com
SALESFORCE_GTCX_LOGIN_URL=https://test.salesforce.com
SALESFORCE_GTCX_CLIENT_ID=your_gtcx_client_id_here
SALESFORCE_GTCX_CLIENT_SECRET=your_gtcx_client_secret_here
SALESFORCE_GTCX_REFRESH_TOKEN=your_gtcx_refresh_token_here
SALESFORCE_GTCX_USERNAME=your_gtcx_username@example.com
SALESFORCE_GTCX_PASSWORD=your_gtcx_password
SALESFORCE_GTCX_SECURITY_TOKEN=your_gtcx_security_token_here
SALESFORCE_GTCX_CLI_ALIAS=GTCX

# DemoCX sandbox
SALESFORCE_DEMOCX_SFDX_AUTH_URL=force://client_id:client_secret:refresh_token@your-instance.my.salesforce.com
SALESFORCE_DEMOCX_LOGIN_URL=https://test.salesforce.com
SALESFORCE_DEMOCX_CLIENT_ID=your_democx_client_id_here
SALESFORCE_DEMOCX_CLIENT_SECRET=your_democx_client_secret_here
SALESFORCE_DEMOCX_REFRESH_TOKEN=your_democx_refresh_token_here
SALESFORCE_DEMOCX_USERNAME=your_democx_username@example.com
SALESFORCE_DEMOCX_PASSWORD=your_democx_password
SALESFORCE_DEMOCX_SECURITY_TOKEN=your_democx_security_token_here
SALESFORCE_DEMOCX_CLI_ALIAS=DemoCX

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Server port (optional, defaults to 3001)
PORT=3001
